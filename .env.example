# HireMinds local environment template. Place real values in .env (gitignored).
# Never expose DATABASE_URL, Supabase secret keys, Groq keys, or Bhashini keys as VITE_* variables.

# Vercel / Vite frontend (public values embedded in the browser bundle)
VITE_API_BASE_URL="https://YOUR-RENDER-SERVICE.onrender.com"
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Render backend (server-side only)
# Use the Supabase Session Pooler connection string and include sslmode=require.
APP_ENV="production"
DATABASE_URL="postgresql://USER:PASSWORD@SESSION-POOLER-HOST:5432/postgres?sslmode=require"
DB_POOL_MAX="5"
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"
GROQ_API_KEY_1="gsk_REPLACE_ME"
GROQ_API_KEY_2="gsk_REPLACE_ME"
GROQ_API_KEY_3="gsk_REPLACE_ME"
GROQ_MODEL="openai/gpt-oss-120b"
BHASHINI_UDYAT_KEY="REPLACE_ME"
BHASHINI_INFERENCE_KEY="REPLACE_ME"
BHASHINI_PIPELINE_ID="64392f96daac500b55c543cd"
FRONTEND_URL="https://YOUR-VERCEL-PROJECT.vercel.app"
CORS_ORIGINS="https://YOUR-VERCEL-PROJECT.vercel.app"

# Supabase Edge Function secrets still used by non-interview functions.
# SUPABASE_URL and platform API keys are injected by Supabase automatically.
RESEND_API_KEY="re_REPLACE_ME"
