# =================================================================
# HireMinds AI Hiring Orchestrator - Environment Configuration Template
# =================================================================

# Supabase Client Configuration (Safe for browser / Vite)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Groq LLM Infrastructure (Supabase Edge Functions / Backend)
# Supports multi-key round-robin load distribution and automatic failover
GROQ_API_KEY_1="gsk_your_primary_groq_api_key"
# GROQ_API_KEY_2="gsk_your_secondary_groq_api_key"
# GROQ_API_KEY_3="gsk_your_tertiary_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"

# Bhashini Indian Language Voice Infrastructure (ASR & TTS)
# Accepts Udyat / ULCA API credentials
BHASHINI_UDYAT_KEY="your-bhashini-udyat-key"
BHASHINI_INFERENCE_KEY="your-bhashini-inference-key"
# Optional ULCA aliases:
# BHASHINI_USER_ID="your-ulca-user-id"
# BHASHINI_ULCA_API_KEY="your-ulca-api-key"
